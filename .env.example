# Copy to .env and edit. Never commit .env.

# Name of this instance: container, compose project and image (<name>:local).
# For a second, independent instance clone the repo into another folder and set a
# different CONTAINER_NAME, DATA_DIR, SSH_PORT and RC_PREFIX there.
CONTAINER_NAME=nas-agent

# Host folder for everything persistent (logins, agent installs, projects).
DATA_DIR=/volume1/docker/nasclaude/data

# Optional: projects folder. Default is DATA_DIR/workspace. Point several instances at the
# same folder to share projects (logins stay separate in each DATA_DIR). Must already exist.
# WORKSPACE_DIR=/volume1/docker/shared-workspace

# Run `id` on the NAS (SSH) and put your uid/gid here. DATA_DIR must be writable by them.
# Default PGID=10 is the 'admin' group on UGREEN UGOS; on other systems use the gid from `id`.
PUID=1000
PGID=10

TZ=UTC

# SSH: key-only. Paste your PUBLIC key(s) here; separate multiple keys with ';'.
SSH_AUTHORIZED_KEYS=ssh-ed25519 AAAA...replace-with-your-public-key... phone
SSH_PORT=2222
# 0.0.0.0 = LAN + Tailscale (do NOT forward this port on your router).
SSH_BIND_IP=0.0.0.0

# Optional git identity for commits
GIT_USER_NAME=
GIT_USER_EMAIL=

# Claude Remote Control (server mode)
RC_PREFIX=nas
# same-dir: all sessions start in /data/workspace | worktree: needs a git repo
RC_SPAWN=same-dir
RC_CAPACITY=8

# Tools installed on first start into DATA_DIR/.home (update later with install-agents.sh)
INSTALL_CODEX=true
INSTALL_WRANGLER=true
# Google Cloud CLI (~400 MB) and Firebase CLI
INSTALL_GCLOUD=true
INSTALL_FIREBASE=true
# Register the Firebase MCP server in Claude Code (off by default)
FIREBASE_MCP=false

# Recreate tmux windows (names, folders, Claude conversations) after a restart or rebuild
TMUX_RESTORE=true
# Headless Chromium in the image (~350 MB) for screenshots / playwright-core. Needs a rebuild.
INSTALL_CHROMIUM=true
